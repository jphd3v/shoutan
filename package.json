{
  "name": "shoutan",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/shippori-mincho": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "~57.0.31",
    "expo-audio": "~57.0.5",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@oxlint/plugins": "1.87.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "oxlint": "1.87.0",
    "pg": "8.23.0",
    "prettier": "3.9.10",
    "supabase": "2.120.0",
    "test-renderer": "1.3.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "test:coverage": "jest --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0 && oxlint -c oxlint.config.mts App.tsx src --deny-warnings",
    "guard": "node scripts/check-guards.mjs",
    "verify": "node scripts/verify.mjs",
    "prepare": "husky || true",
    "test:db": "node scripts/test-db.mjs",
    "test:schema": "node scripts/test-schema.mjs",
    "test:offline": "node scripts/test-offline.mjs",
    "reports": "node scripts/reports.mjs",
    "build:local": "node scripts/build-apk.mjs local",
    "build:dev": "node scripts/build-apk.mjs dev",
    "build:prod": "node scripts/build-apk.mjs prod",
    "test:online": "node --import tsx scripts/test-online.mjs",
    "setup": "node scripts/setup.mjs",
    "maestro:install": "node scripts/install-maestro.mjs",
    "lint:workflows": "node scripts/lint-workflows.mjs",
    "test:scripts": "node --test 'scripts/tests/*.test.mjs'",
    "sync-issues": "node scripts/sync-issues.mjs",
    "infra": "node scripts/infra.mjs",
    "status": "node scripts/status.mjs",
    "sounds": "node scripts/make-sounds.mjs",
    "icons": "node scripts/make-icons.mjs",
    "welcome-art": "node scripts/make-welcome-art.mjs",
    "notices": "node scripts/make-notices.mjs",
    "publish:public": "node scripts/publish-public.mjs",
    "test:full": "node scripts/test-offline.mjs --full",
    "verify:all": "node scripts/verify.mjs --all"
  },
  "private": true,
  "license": "AGPL-3.0-only",
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/e2e/",
      "/supabase/"
    ],
    "testMatch": [
      "**/?(*.)test.ts?(x)"
    ],
    "collectCoverageFrom": [
      "src/go/**/*.ts",
      "src/online/**/*.ts",
      "src/net/match.ts",
      "src/net/lobby.ts",
      "src/report/reporter.ts",
      "src/ui/cues.ts",
      "!**/__tests__/**"
    ],
    "coverageReporters": [
      "text-summary",
      "text"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 90,
        "branches": 85,
        "functions": 90,
        "lines": 90
      }
    },
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "testTimeout": 20000
  },
  "engines": {
    "node": ">=24.21.0",
    "npm": ">=12.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "packageManager": "npm@12.2.0"
}
