# Everything the hosted Go deployment is made from. Copy this file to
#   ~/.config/shoutan/infra.env
# (outside the repository; never commit the filled-in copy), fill it in, then from the repository root:
#   npm run infra -- --plan     see what would change
#   npm run infra               create or repair everything
# Keep a copy of the filled-in file and the signing key in your password manager: together
# they recreate the deployment. Data (games, reports) is not recreated.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Personal access token: https://supabase.com/dashboard/account/tokens → Generate new token.
# It can only be made on that page. Resource access: Project, only the shared project.
# Capabilities: Project Settings read, API Keys read, Connection Pooling read,
# Auth Config read-write, Data API Config read-write, Database read-write. Changing sign-in
# settings (email codes on, anonymous sign-ins off) may also need project admin rights; without
# them npm run infra lists the changes to make by hand.
# Only npm run infra uses it, so a short expiry is fine; access cannot be changed later.
SUPABASE_ACCESS_TOKEN=

# Shared project (the usual setup): Go lives as the schema go, with roles
# go_owner and go_reports, inside a project other apps also use. npm run infra only adds and
# repairs Go's own parts and never creates, replaces or deletes the project.
# The project ref is the part after /project/ in its dashboard address.
SUPABASE_PROJECT_REF=
# Family members sign in with an email code. Sign-in settings are project-wide: npm run infra
# turns anonymous sign-ins off and adds the code to the magic-link and confirmation emails,
# keeping the links other apps rely on. Email needs the project's own mail server (custom SMTP,
# set in the dashboard; another app in the project may already have one): npm run status checks it.

# Own project (only when SUPABASE_PROJECT_REF is empty): created by name when missing.
SUPABASE_ORG_SLUG=
SUPABASE_PROJECT_NAME=shoutan
SUPABASE_REGION=eu-north-1
# The new project's database owner password. Long and random.
SUPABASE_DB_PASSWORD=

# The code players type once to join online play, in Shoutan Dev and the prod app alike. 12+ characters,
# e.g. three unrelated words: anyone with the app can try codes, and nothing limits the guesses.
GO_FAMILY_CODE=
# Password of the restricted go_reports login (reports and release checks). 16+ letters,
# digits, - or _. For example: openssl rand -hex 24
GO_REPORTS_DB_PASSWORD=

# ── GitHub ───────────────────────────────────────────────────────────────────
# owner/name. Created private if missing; making it public is up to you, on GitHub.
GITHUB_REPO=
# Optional: the URL to add as origin, for example an SSH alias (git@github.com-me:owner/name.git).
# Defaults to the repository's SSH URL.
GITHUB_REMOTE_URL=

# ── Release signing ──────────────────────────────────────────────────────────
# Phones only accept updates signed with the same key: never create a second one. Restore it
# from your backup. Only for the very first setup, npm run infra prints the keytool command.
GO_KEYSTORE_FILE=~/.config/shoutan/shoutan-release.keystore
GO_KEYSTORE_PASSWORD=
GO_KEY_ALIAS=shoutan

# ── Google Play (optional) ───────────────────────────────────────────────────
# Release Shoutan can also upload the app bundle to Google Play's internal testing track
# (docs/releasing.md, "Google Play"). The JSON key of a service account made only for this, invited
# in Play Console to this app alone with release-to-testing-tracks permissions and nothing for production.
# Keep it outside the repository, like the signing key.
GO_PLAY_SERVICE_ACCOUNT_FILE=
# Keep off until the first internal testing release was made by hand in Play Console and the key
# is in place; then on.
GO_PLAY_INTERNAL_UPLOAD=off
